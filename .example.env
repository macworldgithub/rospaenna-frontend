# Server only. This key must match BOOKING_API_KEY in the Python backend.
BOOKING_BACKEND_URL=http://127.0.0.1:4040
BOOKING_API_KEY=replace-with-the-backend-api-key

# Existing BRS checkout connection; these session values may expire.
BRS_GOLF_COOKIE=
BRS_GOLF_XSRF_TOKEN=
# Local pause after BRS 429 when no Retry-After is supplied (30-3600 seconds).
# This does not guarantee when BRS will allow requests again.
BRS_CHECKOUT_COOLDOWN_SECONDS=300

# MongoDB is owned by the Python backend. No MongoDB URI is needed here.
# If kept in a local env file, use MONGODB_URI only, never NEXT_PUBLIC_MONGODB_URI.
